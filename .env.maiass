    # MAIASS Configuration
# Generated on 2025-07-21T23:00:49.028Z

# Core Settings
# Verbosity level (brief/normal/verbose)
#MAIASS_VERBOSITY=debug
# Enable debug mode
#MAIASS_DEBUG=true

# Version Management Settings
# Primary version file (usually auto-detected from package.json)
#MAIASS_VERSION_PRIMARY_FILE=package.json
# Secondary files that should have their versions updated (comma-separated)
#MAIASS_VERSION_SECONDARY_FILES=src/version.js,lib/constants.js,docs/version.md

# Auto-Yes Functionality (for CI/CD and non-interactive mode)
# Automatically stage unstaged changes without prompting
#MAIASS_AUTO_STAGE_UNSTAGED=false
# Automatically push commits to remote without prompting
#MAIASS_AUTO_PUSH_COMMITS=false
# Automatically merge to develop branch without prompting
#MAIASS_AUTO_MERGE_TO_DEVELOP=false
# Automatically use AI and approve AI commit suggestions without prompting
#MAIASS_AUTO_APPROVE_AI_SUGGESTIONS=false

# Push Control (legacy compatibility)
# Options: blank/ask (prompt user - default), 'always' (auto-push), 'never' (skip push)
#MAIASS_PUSH_ABSTRACTS_TO_REMOTE=

# Patch Release Control
# Options: blank/no (skip release branch - default), 'ask' (prompt user), 'always' (create release)
#MAIASS_PATCH_RELEASES=

# Version Checking
# Automatically check for updates on startup
#MAIASS_AUTO_UPDATE_CHECK=true

# Invalid Token Behavior
# Show choices when token is invalid (false = auto-create anonymous subscription)
#MAIASS_AI_INVALID_TOKEN_CHOICES=false


