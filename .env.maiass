    # MAIASS Configuration
# Generated on 2025-07-21T23:00:49.028Z

# Core Settings
# Verbosity level (brief/normal/verbose)
#MAIASS_VERBOSITY=debug
# Enable debug mode
#MAIASS_DEBUG=true

# Version Management Settings
# Primary version file (usually auto-detected from package.json)
MAIASS_VERSION_PRIMARY_FILE=package.json
# Secondary files that should have their versions updated (comma-separated)
#MAIASS_VERSION_SECONDARY_FILES=src/version.js,lib/constants.js,docs/version.md

# Auto-Yes Functionality (for CI/CD and non-interactive mode)
# Automatically stage unstaged changes without prompting
#MAIASS_AUTO_STAGE_UNSTAGED=false
# Automatically push commits to remote without prompting
#MAIASS_AUTO_PUSH_COMMITS=false
# Automatically merge to develop branch without prompting
#MAIASS_AUTO_MERGE_TO_DEVELOP=false
# Automatically use AI and approve AI commit suggestions without prompting
#MAIASS_AUTO_APPROVE_AI_SUGGESTIONS=false

# Push Control
# Options: blank/ask (prompt user - default), 'always' (auto-push), 'never' (skip push)
#MAIASS_PUSH_ABSTRACTS_TO_REMOTE=

# Patch Release Control
# Options: blank/no (skip release branch - default), 'ask' (prompt user), 'always' (create release)
#MAIASS_PATCH_RELEASES=

# Version Checking
# Automatically check for updates on startup
#MAIASS_AUTO_UPDATE_CHECK=true

# Invalid Token Behavior
# Show choices when token is invalid (false = auto-create anonymous subscription)
#MAIASS_AI_INVALID_TOKEN_CHOICES=false

# AI Configuration
# AI model to use for commit messages
#MAIASS_AI_MODEL=gpt-4
# AI temperature (0.0-1.0, higher = more creative)
#MAIASS_AI_TEMPERATURE=0.8
# Maximum characters to send to AI
#MAIASS_AI_MAX_CHARACTERS=8000
# AI mode (ask/always/off)
#MAIASS_AI_MODE=ask

# Branch Configuration
# Development branch name
#MAIASS_DEVELOPBRANCH=develop
# Staging branch name
#MAIASS_STAGINGBRANCH=staging
# Main/production branch name
#MAIASS_MAINBRANCH=main

# Changelog Configuration
# Path to changelog directory
#MAIASS_CHANGELOG_PATH=.
# Public changelog filename
#MAIASS_CHANGELOG_NAME=CHANGELOG.md
# Internal changelog filename
#MAIASS_CHANGELOG_INTERNAL_NAME=.CHANGELOG_internal.md
# Internal changelog path
#MAIASS_CHANGELOG_INTERNAL_PATH=.

# Repository Configuration
# Repository type (bespoke/wordpress-theme/wordpress-plugin/wordpress-site/craft)
#MAIASS_REPO_TYPE=bespoke
# Repository provider (github/bitbucket)
#MAIASS_REPO_PROVIDER=
# GitHub owner/organization
#MAIASS_GITHUB_OWNER=
# GitHub repository name
#MAIASS_GITHUB_REPO=
# Bitbucket workspace
#MAIASS_BITBUCKET_WORKSPACE=
# Bitbucket repository slug
#MAIASS_BITBUCKET_REPO_SLUG=

# Pull Request Configuration
# Create pull requests for staging branch (on/off)
#MAIASS_STAGING_PULLREQUESTS=on
# Create pull requests for main branch (on/off)
#MAIASS_MAIN_PULLREQUESTS=on

# Logging Configuration
# Enable logging to file
#MAIASS_LOGGING=true
# Log file path
#MAIASS_LOG_FILE=maiass.log
# Hide git output
#MAIASS_HIDEGIT=true

# Client Identity (for proxy version enforcement)
#MAIASS_CLIENT_NAME=nodemaiass
#MAIASS_CLIENT_VERSION=5.7.33


MAIASS_DEVLOG_CLIENT="Velvary"
MAIASS_DEVLOG_SUBCLIENT="MAIASS"
MAIASS_DEVLOG_PROJECT="nodemaiass"